PORT=3003

# AWS DocumentDB Connection String (PRODUÇÃO - com certificado TLS)
# O certificado é baixado automaticamente no Dockerfile
MONGODB_URI=mongodb://admin:password@your-docdb-cluster.us-east-2.docdb.amazonaws.com:27017/medical_patients?tls=true&tlsCAFile=global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# AWS DocumentDB (DESENVOLVIMENTO - sem validar certificado)
# Use esta opção se tiver problemas com certificados em desenvolvimento
# MONGODB_URI=mongodb://admin:password@your-docdb-cluster.us-east-2.docdb.amazonaws.com:27017/medical_patients?tls=true&tlsAllowInvalidCertificates=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# Para desenvolvimento local com MongoDB (alternativa):
# MONGODB_URI=mongodb://localhost:27017/medical_patients

NODE_ENV=development
AUTH_SERVICE_URL=http://auth-service:3001
DOCTORS_SERVICE_URL=http://doctors-service:3002
