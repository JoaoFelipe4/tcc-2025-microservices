PORT=3001

# AWS DocumentDB Connection String (PRODUÇÃO - com certificado TLS)
# O certificado é baixado automaticamente no Dockerfile
MONGODB_URI=mongodb://admin:password@your-docdb-cluster.us-east-2.docdb.amazonaws.com:27017/medical_auth?tls=true&tlsCAFile=global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# AWS DocumentDB (DESENVOLVIMENTO - sem validar certificado)
# Use esta opção se tiver problemas com certificados em desenvolvimento
# MONGODB_URI=mongodb://admin:password@your-docdb-cluster.us-east-2.docdb.amazonaws.com:27017/medical_auth?tls=true&tlsAllowInvalidCertificates=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# Para desenvolvimento local com MongoDB (alternativa):
# MONGODB_URI=mongodb://localhost:27017/medical_auth

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
NODE_ENV=development
DOCTORS_SERVICE_URL=http://doctors-service:3002
PATIENTS_SERVICE_URL=http://patients-service:3003
