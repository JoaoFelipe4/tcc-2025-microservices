# Docker Compose Environment Variables
# Copie este arquivo para .env e preencha com suas credenciais

# AWS DocumentDB Connection Strings (PRODUÇÃO - com certificado TLS)
# O certificado global-bundle.pem é baixado automaticamente nos Dockerfiles
# Formato: mongodb://<username>:<password>@<cluster-endpoint>:27017/<database>?tls=true&tlsCAFile=global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

MONGODB_URI_AUTH=mongodb://admin:password@your-docdb-cluster.us-east-2.docdb.amazonaws.com:27017/medical_auth?tls=true&tlsCAFile=global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
MONGODB_URI_DOCTORS=mongodb://admin:password@your-docdb-cluster.us-east-2.docdb.amazonaws.com:27017/medical_doctors?tls=true&tlsCAFile=global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
MONGODB_URI_PATIENTS=mongodb://admin:password@your-docdb-cluster.us-east-2.docdb.amazonaws.com:27017/medical_patients?tls=true&tlsCAFile=global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# AWS DocumentDB (DESENVOLVIMENTO - sem validar certificado)
# Use estas opções se tiver problemas com certificados durante o desenvolvimento
# MONGODB_URI_AUTH=mongodb://admin:password@your-docdb-cluster.us-east-2.docdb.amazonaws.com:27017/medical_auth?tls=true&tlsAllowInvalidCertificates=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
# MONGODB_URI_DOCTORS=mongodb://admin:password@your-docdb-cluster.us-east-2.docdb.amazonaws.com:27017/medical_doctors?tls=true&tlsAllowInvalidCertificates=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
# MONGODB_URI_PATIENTS=mongodb://admin:password@your-docdb-cluster.us-east-2.docdb.amazonaws.com:27017/medical_patients?tls=true&tlsAllowInvalidCertificates=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production_use_long_random_string
JWT_EXPIRE=7d

# Para desenvolvimento local com MongoDB local (alternativa):
# MONGODB_URI_AUTH=mongodb://localhost:27017/medical_auth
# MONGODB_URI_DOCTORS=mongodb://localhost:27017/medical_doctors
# MONGODB_URI_PATIENTS=mongodb://localhost:27017/medical_patients
